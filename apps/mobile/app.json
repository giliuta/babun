{
  "expo": {
    "name": "Babun",
    "slug": "babun",
    "scheme": "babun",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.babun.crm",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.babun.crm",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "backgroundColor": "#f1f0f7"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Babun uses your photo library so you can attach photos of job sites, completed work and receipts.",
          "cameraPermission": "Babun uses the camera to photograph job sites, completed work and receipts, and to scan documents you attach.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Babun reads your contacts only when you open “From phone contacts”, so you can choose people to add as clients."
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "locales": {
      "en": "./locales/en.json",
      "ru": "./locales/ru.json",
      "uk": "./locales/uk.json",
      "bg": "./locales/bg.json",
      "el": "./locales/el.json",
      "de": "./locales/de.json",
      "es": "./locales/es.json"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01a65b63-51e6-49d1-8405-96673cfa8676"
      }
    },
    "owner": "artemgiliuta",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/01a65b63-51e6-49d1-8405-96673cfa8676"
    }
  }
}
